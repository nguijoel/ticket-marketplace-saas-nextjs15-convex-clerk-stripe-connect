<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <match url="/*"/>
          <action type="Rewrite" url="start.js"/>
        </rule>
      </rules>
    </rewrite>
    <tracing>
      <traceFailedRequests>
        <clear/>
      </traceFailedRequests>
    </tracing>
    <httpErrors>
      <remove statusCode="400"/>
      <error statusCode="400" path="C:\ClientSites\ontoo.cloud\error_docs\bad_request.html"/>
      <remove statusCode="401"/>
      <error statusCode="401" path="C:\ClientSites\ontoo.cloud\error_docs\unauthorized.html"/>
      <remove statusCode="403"/>
      <error statusCode="403" path="C:\ClientSites\ontoo.cloud\error_docs\forbidden.html"/>
      <remove statusCode="404"/>
      <error statusCode="404" path="C:\ClientSites\ontoo.cloud\error_docs\not_found.html"/>
      <remove statusCode="405"/>
      <error statusCode="405" path="C:\ClientSites\ontoo.cloud\error_docs\method_not_allowed.html"/>
      <remove statusCode="406"/>
      <error statusCode="406" path="C:\ClientSites\ontoo.cloud\error_docs\not_acceptable.html"/>
      <remove statusCode="407"/>
      <error statusCode="407" path="C:\ClientSites\ontoo.cloud\error_docs\proxy_authentication_required.html"/>
      <remove statusCode="412"/>
      <error statusCode="412" path="C:\ClientSites\ontoo.cloud\error_docs\precondition_failed.html"/>
      <remove statusCode="414"/>
      <error statusCode="414" path="C:\ClientSites\ontoo.cloud\error_docs\request-uri_too_long.html"/>
      <remove statusCode="415"/>
      <error statusCode="415" path="C:\ClientSites\ontoo.cloud\error_docs\unsupported_media_type.html"/>
      <remove statusCode="500"/>
      <error statusCode="500" path="C:\ClientSites\ontoo.cloud\error_docs\internal_server_error.html"/>
      <remove statusCode="501"/>
      <error statusCode="501" path="C:\ClientSites\ontoo.cloud\error_docs\not_implemented.html"/>
      <remove statusCode="502"/>
      <error statusCode="502" path="C:\ClientSites\ontoo.cloud\error_docs\bad_gateway.html"/>
      <remove statusCode="503"/>
      <error statusCode="503" path="C:\ClientSites\ontoo.cloud\error_docs\maintenance.html"/>
    </httpErrors>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="C:\ClientSites\ontoo.cloud\tmp"/>
  </system.web>
</configuration>
